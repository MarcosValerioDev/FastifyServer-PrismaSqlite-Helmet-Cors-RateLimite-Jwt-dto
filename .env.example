# Ambiente: development | production | test
NODE_ENV=development

# Servidor
HOST=0.0.0.0
PORT=3333

# Banco SQLite (caminho relativo à raiz do projeto)
DATABASE_URL="file:./prisma/dev.db"

# JWT — troque por um segredo forte (mín. 32 caracteres) em produção
JWT_SECRET="troque-este-segredo-por-um-valor-forte-e-aleatorio"
JWT_EXPIRES_IN=1d

# CORS — "*" ou lista separada por vírgula (ex.: http://localhost:5173,https://meusite.com)
CORS_ORIGIN=*

# Rate limit global
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"
